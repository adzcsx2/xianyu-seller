[run]
branch = True
relative_files = True
source =
    .
omit =
    .tmp/*
    .venv/*
    frontend/*
    static/*
    tests/*

[report]
precision = 1
show_missing = True
skip_empty = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:

[xml]
output = .tmp/test-artifacts/coverage.xml
