# Copy this file to .env before running Docker Compose.
# false：免登录直接进入后台；true：必须手动登录，Docker 重启后需重新登录。
# 免登录等同于向能访问管理端口的人授予管理员权限，切勿暴露到不受信任的网络。
ADMIN_LOGIN_ENABLED=true
SESSION_TIMEOUT_SECONDS=86400
# 默认关闭自动轨迹滑块，命中风控后转到账号管理页由真人完成。
AUTO_SLIDER_ENABLED=false
# 每次启动都会把内置管理员同步为这里的账号密码。
# 不填则使用 admin / admin123。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

WEB_PORT=8080
TZ=Asia/Shanghai
LOG_LEVEL=INFO
SQL_LOG_ENABLED=true

AUTO_REPLY_ENABLED=true
AUTO_DELIVERY_ENABLED=true
AI_REPLY_ENABLED=false

# Optional resource limits.
MEMORY_LIMIT=2048M
MEMORY_RESERVATION=512M
CPU_LIMIT=2.0
CPU_RESERVATION=0.5
